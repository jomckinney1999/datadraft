# Copy to .env.local and fill in real values. .env.local is gitignored —
# never commit real keys.

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses Row Level Security — server-side only
# (webhook handlers, cron jobs). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=
# From Dashboard > Developers > Webhooks, after adding the endpoint
STRIPE_WEBHOOK_SECRET=
# The Season Pass's three prices (docs/OFFER.md). Run
#   node --env-file=.env.local scripts/setup-stripe-products.mjs
# once with the secret key set, and it prints these three lines.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_FOUNDING=

# --- AI Coach (optional) ---
# Vercel AI Gateway — enables Coach Blitz tips in lessons via /api/coach.
# On Vercel, OIDC can auth the gateway without a key; locally set:
# AI_GATEWAY_API_KEY=

# Any long random string — protects /api/cron/ingest-stats from public
# triggering. Vercel automatically sends this as a Bearer token to your
# cron-triggered routes once a project env var with this exact name exists.
CRON_SECRET=
