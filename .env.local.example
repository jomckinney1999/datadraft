# Copy to .env.local and fill in real values. .env.local is gitignored —
# never commit real keys.

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses Row Level Security — server-side only
# (webhook handlers, cron jobs). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=
# From Dashboard > Developers > Webhooks, after adding the endpoint
STRIPE_WEBHOOK_SECRET=
# Price ID for the Practice tier subscription product
NEXT_PUBLIC_STRIPE_PRACTICE_PRICE_ID=

# --- Data pipeline ---
# Any long random string — protects /api/cron/ingest-stats from public
# triggering. Vercel automatically sends this as a Bearer token to your
# cron-triggered routes once a project env var with this exact name exists.
CRON_SECRET=
